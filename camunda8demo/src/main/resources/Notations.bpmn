  <bpmn:collaboration id="Collaboration_1va7lvb">
    <bpmn:participant id="Participant_10skquj" name="NEFT Transaction System" processRef="Process_05lrvpx" />
    <bpmn:participant id="Participant_0ly3hw6" name="Cheque Clearing System" processRef="Process_1tc8981" />
    <bpmn:participant id="Participant_19pnrm9" name="NEFT Transaction System" processRef="Process_0ed9fb1" />
    <bpmn:textAnnotation id="TextAnnotation_15y10jt">
      <bpmn:text>Wait for OTP</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06rp6xa">
      <bpmn:text>OTP Receive max time.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dnx5uy">
      <bpmn:text>Cheque clearance task</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1lcrah2">
      <bpmn:text>Send confirmation cheque cleared</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18ixmca">
      <bpmn:text>Notify customer cheque received for clearing by SMS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0eok005">
      <bpmn:text>This process demonstrated the interrupting message event, means if either of flow triggered at 'NEFT Transaction' or 'Message Received' event, the one of the un-triggered flow will be terminated.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0oq3dki" associationDirection="None" sourceRef="Participant_10skquj" targetRef="TextAnnotation_0eok005" />
    <bpmn:association id="Association_1om64ri" associationDirection="None" sourceRef="Event_127n87f" targetRef="TextAnnotation_06rp6xa" />
    <bpmn:textAnnotation id="TextAnnotation_1ai7zp9">
      <bpmn:text>This process demonstrated the non-interrupting message event, means if either of flow triggered at 'NEFT Transaction' or 'Message Received' event, the one of the un-triggered flow will be still continue as it like normal flow.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_13kuilg" associationDirection="None" sourceRef="Participant_0ly3hw6" targetRef="TextAnnotation_1ai7zp9" />
    <bpmn:association id="Association_09g3wow" associationDirection="None" sourceRef="Activity_1xugp8l" targetRef="TextAnnotation_0dnx5uy" />
    <bpmn:textAnnotation id="TextAnnotation_0j9xhrj">
      <bpmn:text>This process demonstrated the process terminated event, means if either of flow triggered at 'NEFT Transaction' or 'Message Received' event, the one of the un-triggered flow will be still continue as it like normal flow.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0fac45p" associationDirection="None" sourceRef="Participant_19pnrm9" targetRef="TextAnnotation_0j9xhrj" />
    <bpmn:textAnnotation id="TextAnnotation_0xr7ads">
      <bpmn:text>Wait for OTP</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
