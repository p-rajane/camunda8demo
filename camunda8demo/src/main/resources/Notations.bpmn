      <bpmn:incoming>Flow_0z36mc1</bpmn:incoming>
      <bpmn:outgoing>Flow_10bi40v</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_07ja59n" name="Send SMS cheque recieved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-microsoft-teams:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="clientCredentials" target="authentication.type" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.tenantId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input source="chat" target="data.type" />
          <zeebe:input source="sendMessageToChat" target="data.method" />
          <zeebe:input target="data.chatId" />
          <zeebe:input target="data.content" />
          <zeebe:input source="TEXT" target="data.bodyType" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.MSTeams.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
