    <bpmn:textAnnotation id="TextAnnotation_0eok005">
      <bpmn:text>This process demonstrated the interrupting message event, means if either of flow triggered at 'NEFT Transaction' or 'Message Received' event, the one of the un-triggered flow will be terminated.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0oq3dki" associationDirection="None" sourceRef="Participant_10skquj" targetRef="TextAnnotation_0eok005" />
    <bpmn:textAnnotation id="TextAnnotation_1ai7zp9">
      <bpmn:text>This process demonstrated the non-interrupting message event, means if either of flow triggered at 'NEFT Transaction' or 'Message Received' event, the one of the un-triggered flow will be still continue as it like normal flow.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_13kuilg" associationDirection="None" sourceRef="Participant_0ly3hw6" targetRef="TextAnnotation_1ai7zp9" />
    <bpmn:textAnnotation id="TextAnnotation_0j9xhrj">
